{
  "name": "PhishGuard - ML Phishing Detector",
  "version": "1.0",
  "description": "Detects phishing URLs using machine learning and VirusTotal",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://phishdetect-api.replit.app/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
  "host_permissions": [
  "http://localhost:5000/*",
  "https://web-production-0d15.up.railway.app/*",
  "https://*/*"
],
}
